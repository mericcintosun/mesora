# Mesora runs fully without any of these: the step form, the link codec and the
# solver need no keys, and the agent falls back to a rule parser (or your local
# `claude` CLI in development). Set one provider for the real agent path.

# Public base URL of the deployed site, used for metadataBase (absolute og:image URLs).
# Public by design, not a secret. Defaults to https://mesora-three.vercel.app.
NEXT_PUBLIC_SITE_URL=https://mesora-three.vercel.app

# Data adapter: `fake` (seed data and the cached travel table, the default) or `real`
# (live OSRM driving minutes between district centers; venues are still the sample list).
ADAPTER_MODE=fake

# OSRM base URL for the travel-time table. Optional. Defaults to the keyless public
# server https://router.project-osrm.org. A self-hosted OSRM URL also works.
OSRM_BASE_URL=https://router.project-osrm.org

# Mozilla Otari API key (starts with otk_). Get it from your Otari account dashboard.
OTARI_API_KEY=
# Otari's OpenAI-compatible base URL, copied from the same dashboard (ends in /api/v1).
OTARI_BASE_URL=
# Optional. Defaults to alibaba/qwen3.8-flash.
OTARI_MODEL=

# OpenRouter API key. Create one at https://openrouter.ai/keys (free models need no credit).
OPENROUTER_API_KEY=
# Optional. Any ":free" model id from https://openrouter.ai/models works.
OPENROUTER_MODEL=

# Filled by next.config.ts at build time from public/brand/*.png. Leave empty; listed so every env key is documented.
NEXT_PUBLIC_BRAND_FILES=

# Proof only, read by scripts/proof.mjs (never by the app): base URL for the demo-path proof, e.g. your deployed site.
PROOF_BASE_URL=

# Set by Vercel automatically. When present the local `claude` CLI path is skipped. Leave empty locally.
VERCEL=
