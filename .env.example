# Mesora runs fully without any of these: the step form, the link codec and the
# solver need no keys, and the agent falls back to a rule parser (or your local
# `claude` CLI in development). Set one provider for the real agent path.

# Mozilla Otari API key (starts with otk_). Get it from your Otari account dashboard.
OTARI_API_KEY=
# Otari's OpenAI-compatible base URL, copied from the same dashboard (ends in /v1).
OTARI_BASE_URL=
# Optional. Defaults to alibaba/qwen3.8-flash.
OTARI_MODEL=

# OpenRouter API key. Create one at https://openrouter.ai/keys (free models need no credit).
OPENROUTER_API_KEY=
# Optional. Any ":free" model id from https://openrouter.ai/models works.
OPENROUTER_MODEL=
